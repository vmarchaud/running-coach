# Focale watching (OpenTelemetry OTLP/HTTP intake).
# Replace <your-ingest-key> with your real ingest key (do not commit a live key).
# Format: https://<ingest-key>@<host> — the key is sent as a Bearer token to
# <host>/v1/{traces,metrics,logs}.
FOCALE_DSN=http://<your-ingest-key>@127.0.0.1:4318

# Optional fallbacks used when FOCALE_DSN is not set:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
